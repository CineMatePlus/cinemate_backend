# Application
PROJECT_NAME=CineMate API
PROJECT_DESCRIPTION=Movie and TV collection API
PROJECT_VERSION=1.0.0
API_V1_STR=/api/v1

# Comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MongoDB Atlas Local (docker-compose.yml exposes it on 27018 so that an
# existing Windows MongoDB service can keep using 27017.)
MONGODB_URL=mongodb://localhost:27018/?directConnection=true
MONGODB_DB=cinemate
TEST_MONGODB_URL=mongodb://localhost:27018/?directConnection=true
TEST_MONGODB_DB=tests

# Authentication
# Generate a unique value for every environment. Example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=32

# Embeddings (Ollama runs natively on Windows, Linux and Apple Silicon)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Set true to fail API startup when the embedding service is unavailable.
EMBEDDING_WARMUP=false
MOVIE_VECTOR_INDEX=movie_vector_index
USER_VECTOR_INDEX=user_vector_index
