```mermaid
classDiagram
    %% Kullanıcı modeli
    class User {
        +email: EmailStr
        +name: string
        +avatar_url: string
        +gender: Gender
        +hashed_password: string
        +created_at: datetime
        +updated_at: datetime
    }

    %% İçerik modeli
    class Content {
        +title: string
        +description: string
        +genres: List[string]
        +year: int
        +type: bool
        +image_url: string
        +average_rating: float
        +num_likes: int
        +num_watches: int
        +num_ratings: int
        +num_comments: int
        +created_at: datetime
        +updated_at: datetime
    }

    %% Koleksiyon modeli
    class Collection {
        +title: string
        +is_public: bool
        +user_id: string
        +content_ids: List[string]
        +created_at: datetime
        +updated_at: datetime
    }

    %% Yorum modeli
    class Comment {
        +text: string
        +content_id: string
        +user_id: string
        +created_at: datetime
        +updated_at: datetime
    }

    %% Kullanıcı-İçerik ilişki modeli
    class UserContent {
        +user_id: string
        +content_id: string
        +is_liked: bool
        +is_watched: bool
        +in_watchlist: bool
        +rated: int
        +last_interacted_at: datetime
    }

    %% Servisler
    class AuthService {
        +register_user()
        +login_user()
        +get_user_from_token()
    }

    class ContentService {
        +create_content()
        +get_content()
        +update_content()
        +delete_content()
        +list_contents()
        +search_contents()
    }

    class CollectionService {
        +create_collection()
        +get_collection()
        +update_collection()
        +delete_collection()
        +list_user_collections()
        +add_content_to_collection()
        +remove_content_from_collection()
    }

    class CommentService {
        +create_comment()
        +get_comment()
        +update_comment()
        +delete_comment()
        +list_content_comments()
    }

    class UserContentService {
        +track_user_content()
        +like_content()
        +add_to_watchlist()
        +mark_as_watched()
        +rate_content()
        +get_user_content()
    }

    %% İlişkiler
    User "1" --> "n" Collection : sahip olur
    User "1" --> "n" Comment : yazar
    User "1" --> "n" UserContent : etkileşim kurar
    
    Content "1" --> "n" Comment : alır
    Content "1" --> "n" UserContent : etkileşim alır
    Content "n" --> "n" Collection : bulunur
    
    AuthService --> User : yönetir
    ContentService --> Content : yönetir
    CollectionService --> Collection : yönetir
    CommentService --> Comment : yönetir
    UserContentService --> UserContent : yönetir
``` 