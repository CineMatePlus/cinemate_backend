classDiagram
    class User {
        ObjectId _id
        string email
        string password
        string name
    }

    class Content {
        ObjectId _id
        string title
        string description
        string[] genres
        int year
        float average_rating
        int num_likes
        int num_watches
        int num_ratings
        int num_comments
    }

    class UserContent {
        ObjectId user_id
        ObjectId content_id
        bool is_liked
        bool is_watched
        bool in_watchlist
        float rated
        datetime last_interacted_at
    }

    class Collection {
        ObjectId _id
        ObjectId user_id
        string title
        ObjectId[] content_ids
    }

    class Comment {
        ObjectId _id
        ObjectId content_id
        ObjectId user_id
        string text
        datetime created_at
    }

    User "1" --> "*" UserContent : interacts
    Content "1" --> "*" UserContent : linked by
    User "1" --> "*" Collection : owns
    Collection "1" --> "*" Content : contains
    User "1" --> "*" Comment : writes
    Content "1" --> "*" Comment : receives
